# Copy to .env before the first `docker compose up`. .env is gitignored.

# --- Postgres ---
POSTGRES_USER=memoryos
POSTGRES_PASSWORD=memoryos
POSTGRES_DB=memoryos
POSTGRES_PORT=5432

# --- Valkey (Redis-compatible) ---
VALKEY_PORT=6379

# --- API / frontend ---
API_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO

# --- What gets indexed ---
# A folder on this machine that holds your notes, PDFs and repos (or folders of repos).
# It is mounted read-only at /sources; register sources by paths relative to it.
# Example: SOURCES_DIR=C:/Users/you/Documents/brain
SOURCES_DIR=./data/sources

# --- Models ---
# http: the model server. By default it runs on the host GPU (.\make.ps1 models).
#       CPU-only machine? `docker compose --profile models up -d` and use http://models:8001
# hash: model-free vectors (fast, weak). none: lexical search only.
EMBEDDER=http
RERANKER=http
MODEL_SERVER_URL=http://host.docker.internal:8001

# --- Chat model providers (Phase 2) ---
# GEMINI_API_KEY=
# GROQ_API_KEY=
