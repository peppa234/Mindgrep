# Copy to .env before the first `docker compose up`. .env is gitignored.

# --- Postgres ---
POSTGRES_USER=mindgrep
POSTGRES_PASSWORD=mindgrep
POSTGRES_DB=mindgrep
POSTGRES_PORT=5432

# --- Valkey (Redis-compatible) ---
VALKEY_PORT=6379

# --- API / frontend ---
API_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO

# --- What gets indexed ---
# A folder on this machine that holds your notes, PDFs and repos (or folders of repos).
# It is mounted read-only at /sources; register sources by paths relative to it.
# Example: SOURCES_DIR=C:/Users/you/Documents/brain
SOURCES_DIR=./data/sources
# GitHub sources: a clone bigger than this on disk is deleted and its run fails.
MAX_REPO_BYTES=2000000000
# Clone URLs must resolve to public addresses. true allows a Git server on your own network.
GIT_ALLOW_PRIVATE_HOSTS=false

# --- Models ---
# http: the model server. By default it runs on the host GPU (.\make.ps1 models).
#       CPU-only machine? `docker compose --profile models up -d` and use http://models:8001
# hash: model-free vectors (fast, weak). none: lexical search only.
EMBEDDER=http
RERANKER=http
MODEL_SERVER_URL=http://host.docker.internal:8001

# --- Chat models ---
# Tried in this order; a provider without its key (or model, for Ollama) is skipped, and a
# rate-limited one is skipped for a minute. All three speak the OpenAI chat protocol.
# Free tiers may use your prompts for training: fine for your own portfolio corpus, not for
# anyone else's data (use Ollama, or a paid tier).
LLM_PROVIDERS=gemini,groq,ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when GEMINI_MODEL is overloaded (503) or silent for GEMINI_TIMEOUT_S seconds.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Gemini 3 models think before writing; "low" keeps the first word within seconds.
GEMINI_REASONING_EFFORT=low
GEMINI_TIMEOUT_S=30
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Local and free: `ollama pull qwen3:8b`, then set OLLAMA_MODEL=qwen3:8b
OLLAMA_MODEL=
# Bulk LLM extraction (.\make.ps1 extract <id>) can use a cheaper chain; empty = the same.
EXTRACTION_PROVIDERS=

# --- Chat behaviour ---
# Top reranker score below which the chat answers "not in your memory" without asking a
# model. Tune it from the Abstention line of `.\make.ps1 eval` and from `.\make.ps1 eval-chat`.
ABSTAIN_THRESHOLD=0.008

# --- Ideas: when does a project count as implementing an idea written in your notes? ---
# coverage: share of the idea's distinctive words found in the project (no model needed).
# similarity: the reranker's score for the idea against the project's closest code.
# Either can decide. Calibrate from the sweep in `.\make.ps1 eval-ideas`.
IDEA_COVERAGE_PARTIAL=0.3
IDEA_COVERAGE_IMPLEMENTED=0.45
IDEA_SIMILARITY_PARTIAL=0.15
IDEA_SIMILARITY_IMPLEMENTED=0.5

# --- Production only (docker-compose.prod.yml, see docs/deploy.md) ---
# DOMAIN=memory.example.com
# BASIC_AUTH_USER=you
# BASIC_AUTH_HASH=   # docker run --rm caddy:2-alpine caddy hash-password
# BACKUP_KEEP_DAYS=14
